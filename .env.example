# ============================================================
# Triplo Xis Lanches - pedidos online
# Copie para .env.local (dev) ou configure na Vercel (producao).
# NUNCA versione o arquivo .env real.
# ============================================================

# ---------- Supabase (banco de dados) ----------
# URL e chave publica: podem aparecer no navegador.
NEXT_PUBLIC_SUPABASE_URL=https://jqqkahibtnwzkevbrhcd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role: SOMENTE no servidor. Ignora RLS.
# Se vazar, da acesso total ao banco. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Pagamento Pix ----------
# Driver ativo: "dev" (desenvolvimento) ou "mercadopago".
# "dev" NAO confirma pagamento sozinho: exige confirmacao manual
# via endpoint protegido. Nunca use "dev" em producao.
PAGAMENTO_PROVIDER=dev

# Chave Pix do recebedor e nome/cidade do beneficiario (payload estatico do driver dev)
PIX_CHAVE=
PIX_BENEFICIARIO=TRIPLO XIS LANCHES
PIX_CIDADE=OSORIO

# Mercado Pago (preencher quando as credenciais existirem)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ---------- Seguranca ----------
# Segredo compartilhado com o agente de impressao local do restaurante.
IMPRESSAO_TOKEN=
# Segredo para as rotas administrativas.
ADMIN_TOKEN=

# ---------- Emissao fiscal (Geranet) ----------
# Ainda nao implementado: aguardando documentacao e credenciais.
FISCAL_PROVIDER=nenhum
GERANET_BASE_URL=
GERANET_TOKEN=
GERANET_AMBIENTE=homologacao

# ---------- Aplicacao ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
