# URL publica da aplicacao (sem barra no final)
BASE_URL=https://seu-app.vercel.app

# Mesmo valor de IMPRESSAO_TOKEN configurado na Vercel
IMPRESSAO_TOKEN=

# Intervalo entre consultas e tamanho do lote
POLL_MS=5000
LOTE=5

# console  -> so mostra o cupom na tela (teste)
# arquivo  -> escreve num dispositivo/compartilhamento
# comando  -> envia pela entrada padrao de um comando
IMPRESSORA_MODO=console

# Para IMPRESSORA_MODO=arquivo
#   Windows (porta USB):        \\.\USB001
#   Windows (impressora share): \\NOME-DO-PC\JP800
#   Linux:                      /dev/usb/lp0
IMPRESSORA_DESTINO=

# Para IMPRESSORA_MODO=comando
#   Linux/macOS: lp -d JP800 -o raw
IMPRESSORA_COMANDO=

LARGURA_COLUNAS=48
